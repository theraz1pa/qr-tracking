# Kopieren nach supabase/functions/.env und hochladen mit:
#   npx supabase secrets set --env-file supabase/functions/.env
# Salt erzeugen mit: openssl rand -hex 32
# Danach nicht mehr ändern – sonst sind alte und neue Hashes nicht vergleichbar.
IP_HASH_SALT=
# Gemeinsames Secret mit dem Vercel-Proxy (dashboard/api/r.ts), gleicher Wert als Vercel-Env-Var QR_PROXY_SECRET.
# Erzeugen: openssl rand -hex 32
QR_PROXY_SECRET=
